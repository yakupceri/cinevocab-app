{
  "manifest_version": 3,
  "name": "CineVocab",
  "version": "1.3",
  "description": "Prime Video Türkçe altyazılarını kelime kelime çevirip kaydeder.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://cinevocab.up.railway.app/*",
    "https://www.primevideo.com/*",
    "https://*.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://*.amazon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
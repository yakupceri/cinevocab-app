{
  "manifest_version": 3,
  "name": "CineVocab",
  "version": "1.5",
  "description": "Prime Video ve YouTube'da Türkçe altyazıları kelime kelime çevirip kaydeder.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cinevocab.up.railway.app/*",
    "https://www.primevideo.com/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}